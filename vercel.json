{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.5.2"
    }
  },
  "rewrites": [
    {
      "source": "/api.php",
      "destination": "/api/shop.php"
    },
    {
      "source": "/",
      "destination": "/api/index.php"
    }
  ]
}
